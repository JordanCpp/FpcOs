UNIT PIC;

{$MODE OBJFPC}

INTERFACE

USES 
  PortIO;

CONST
  { PIC Ports }
  PIC_MASTER_COMMAND = $20;
  PIC_MASTER_DATA    = $21;
  PIC_SLAVE_COMMAND  = $A0;
  PIC_SLAVE_DATA     = $A1;

  { PIC Commands }
  PIC_ICW1_INIT         = $10;
  PIC_ICW1_ICW4_PRESENT = $01;
  PIC_ICW4_8086         = $01;
  PIC_MCU_TYPE_8086     = $01;
  PIC_EOI               = $20;

  { PIC Configuration }
  PIC_IRQ_OFFSET_MASTER   = $28;
  PIC_IRQ_OFFSET_SLAVE    = $38;
  PIC_CASCADE_LINE_MASTER = 2;
  PIC_CASCADE_LINE_SLAVE  = 1;
  PIC_MASK_MASTER_TEST    = $F8;
  PIC_MASK_SLAVE_TEST     = $FE;
  PIC_MASK_DISABLE_ALL    = $FF;

TYPE
  TPICController = OBJECT
    IO: TPortIO;
    PROCEDURE Initialize;
    PROCEDURE SetMask(masterMask, slaveMask: UInt8);
    PROCEDURE DisableAll;
    PROCEDURE SendEOI(isSlave: BOOLEAN);
  END;

IMPLEMENTATION

PROCEDURE TPICController.Initialize;
BEGIN
  IO.Write8(PIC_MASTER_COMMAND, PIC_ICW1_INIT OR PIC_ICW1_ICW4_PRESENT);
  IO.Write8(PIC_MASTER_DATA, PIC_IRQ_OFFSET_MASTER);
  IO.Write8(PIC_MASTER_DATA, PIC_CASCADE_LINE_MASTER);
  IO.Write8(PIC_MASTER_DATA, PIC_MCU_TYPE_8086 OR PIC_ICW4_8086);

  IO.Write8(PIC_SLAVE_COMMAND, PIC_ICW1_INIT OR PIC_ICW1_ICW4_PRESENT);
  IO.Write8(PIC_SLAVE_DATA, PIC_IRQ_OFFSET_SLAVE);
  IO.Write8(PIC_SLAVE_DATA, PIC_CASCADE_LINE_SLAVE);
  IO.Write8(PIC_SLAVE_DATA, PIC_MCU_TYPE_8086 OR PIC_ICW4_8086);

  SetMask(PIC_MASK_MASTER_TEST, PIC_MASK_SLAVE_TEST);
END;

PROCEDURE TPICController.SetMask(masterMask, slaveMask: UInt8);
BEGIN
  IO.Write8(PIC_MASTER_DATA, masterMask);
  IO.Write8(PIC_SLAVE_DATA, slaveMask);
END;

PROCEDURE TPICController.DisableAll;
BEGIN
  SetMask(PIC_MASK_DISABLE_ALL, PIC_MASK_DISABLE_ALL);
END;

PROCEDURE TPICController.SendEOI(isSlave: BOOLEAN);
BEGIN
  IF isSlave THEN
  BEGIN
    IO.Write8(PIC_SLAVE_COMMAND, PIC_EOI);
  END;
  
  IO.Write8(PIC_MASTER_COMMAND, PIC_EOI);
END;

END.
